{
  "name": "bug-reproduction-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Automation test agent monorepo skeleton",
  "workspaces": [
    "backend/api",
    "backend/worker",
    "backend/packages/*",
    "frontend",
    "extension",
    "Agent/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev --workspace @bug-agent/api",
    "dev:backend": "npm run dev --workspace @bug-agent/api",
    "dev:console": "npm run dev --workspace @bug-agent/console",
    "dev:frontend": "npm run dev --workspace @bug-agent/console",
    "dev:worker": "npm run dev --workspace @bug-agent/worker",
    "dev:extension": "npm run dev --workspace @bug-agent/extension",
    "build": "node scripts/run-workspaces.mjs build",
    "test": "node --test && npm run test --workspace @bug-agent/api",
    "check": "npm run build && npm test"
  },
  "engines": {
    "node": ">=20"
  }
}
